# PLANTILLA: valores de ejemplo y campos secretos vacíos; no guardar credenciales reales.
# El programa lee el entorno; este archivo no se carga automáticamente.
# La configuración privada debe quedar en variables del proceso o archivos locales ignorados por Git.
# Autenticación integrada de Windows: no se requieren usuario ni contraseña.
ETL_SOURCE_SERVER=HEBER-ENOC-PINE\SQLEXPRESS
ETL_SOURCE_DATABASE=WideWorldImporters
ETL_TARGET_SERVER=HEBER-ENOC-PINE\SQLEXPRESS
ETL_TARGET_DATABASE=WideWorldImporters_Analytics
ETL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
ETL_BATCH_SIZE=500
ETL_LOGIN_TIMEOUT=10
ETL_QUERY_TIMEOUT=60
ETL_ENCRYPT=yes
# La excepción requiere local y ambas conexiones a HEBER-ENOC-PINE\SQLEXPRESS.
ETL_ENVIRONMENT=production
ETL_TRUST_SERVER_CERTIFICATE=false

# API: configuración independiente del ETL; nunca guardar una clave real aquí.
API_ACCESS_TOKEN=
API_SQL_SERVER=HEBER-ENOC-PINE\SQLEXPRESS
API_SQL_DATABASE=WideWorldImporters_Analytics
API_ODBC_DRIVER=ODBC Driver 17 for SQL Server
API_ENVIRONMENT=production
API_TRUST_SERVER_CERTIFICATE=false
API_LOGIN_TIMEOUT=5
API_QUERY_TIMEOUT=15
API_MAX_CONCURRENT=4

# Entrenamiento batch: reutiliza la política TLS, con configuración ML independiente.
# No necesita API_ACCESS_TOKEN ni escribe en SQL Server.
ML_SQL_SERVER=HEBER-ENOC-PINE\SQLEXPRESS
ML_SQL_DATABASE=WideWorldImporters_Analytics
ML_ODBC_DRIVER=ODBC Driver 17 for SQL Server
ML_ENVIRONMENT=production
ML_TRUST_SERVER_CERTIFICATE=false
ML_LOGIN_TIMEOUT=5
ML_QUERY_TIMEOUT=30
# Directorio compartido por el entrenador y la API; relativo a la raíz del proyecto.
ML_ARTIFACT_DIR=artifacts/ml-sales

# IA generativa implementada; integración y validación con Ollama PENDIENTES.
# El código actual solo tiene adaptador OpenAI; GENAI_PROVIDER=ollama no lo habilita.
# Dejar vacíos hasta configurar expresamente un proveedor compatible. No usar variables VITE_* para secretos.
GENAI_PROVIDER=
GENAI_MODEL=
OPENAI_API_KEY=
# Referencia opcional del adaptador existente: GENAI_PROVIDER=openai y GENAI_MODEL=gpt-4.1-mini.
# No es una configuración de Ollama ni evidencia de integración validada.
GENAI_TIMEOUT=15
GENAI_MAX_OUTPUT_TOKENS=900

# Alertas: SQL 005 y demostración manual (activación, entrega, lectura y cero duplicados) confirmados.
# Reintentos reales y programación automática siguen pendientes de validación.
# Variables de demostración académica, independientes de API/ETL/ML; no reflejan secretos del entorno real.
ALERT_SQL_SERVER=HEBER-ENOC-PINE\SQLEXPRESS
ALERT_SQL_DATABASE=WideWorldImporters_Analytics
ALERT_ODBC_DRIVER=ODBC Driver 17 for SQL Server
ALERT_ENVIRONMENT=production
ALERT_TRUST_SERVER_CERTIFICATE=false
ALERT_QUERY_TIMEOUT=30
ALERT_THRESHOLD_PCT=-10
ALERT_MAX_ATTEMPTS=3
